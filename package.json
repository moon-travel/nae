    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^5.0.1"
  }
